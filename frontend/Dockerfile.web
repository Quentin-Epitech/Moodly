# ---- Étape 1 : export web statique (Expo) ---------------------------------
FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# URL de l'API vue depuis le NAVIGATEUR. Par défaut « /api » : nginx relaie vers le
# conteneur api (même origine, pas de CORS). Une URL absolue reste possible.
ARG EXPO_PUBLIC_API_URL=/api
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
ENV CI=1

RUN npx expo export --platform web

# ---- Étape 2 : serveur statique + relais vers l'API --------------------------
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
