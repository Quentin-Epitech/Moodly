# Copier ce fichier en `.env` (jamais versionné).
#
# URL de l'API, joignable DEPUIS LE TÉLÉPHONE : donc l'IP LAN de la machine qui
# fait tourner le backend (pas localhost), téléphone et machine sur le même Wi-Fi.
#   macOS   : ipconfig getifaddr en0
#   Linux   : hostname -I | awk '{print $1}'
#   Windows : ipconfig  (ligne "Adresse IPv4")
#
# Pour l'app web dans un navigateur sur la même machine (npm run web), http://localhost:4000 suffit.
#
# Les variables EXPO_PUBLIC_* sont injectées dans le bundle au démarrage :
# relancer `npm start` après modification.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
