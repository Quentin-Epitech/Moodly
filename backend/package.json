{
  "name": "moodly-backend",
  "version": "0.1.0",
  "description": "API Moodly — mood tracking anonymisé (Express + Prisma)",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "pg:schema": "node scripts/sync-postgres-schema.mjs",
    "pg:generate": "prisma generate --schema prisma/postgres/schema.prisma",
    "pg:migrate": "node scripts/with-env.mjs .env.supabase prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "pg:seed": "node scripts/with-env.mjs .env.supabase tsx src/seed.ts",
    "pg:studio": "node scripts/with-env.mjs .env.supabase prisma studio --schema prisma/postgres/schema.prisma",
    "pg:dev": "node scripts/with-env.mjs .env.supabase tsx watch src/index.ts",
    "test": "vitest run",
    "test:pg": "npm run pg:generate && vitest run; status=$?; npm run db:generate >/dev/null; exit $status",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "users": "tsx src/cli/users.ts"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
