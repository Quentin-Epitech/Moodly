# Copier ce fichier en `.env` (jamais versionné) et adapter les valeurs.
# Pour la production, partir de `.env.production.example` (voir PRODUCTION.md).

# Port d'écoute de l'API (4000 pour éviter les collisions avec d'autres serveurs de dev sur 3000)
PORT=4000

# Base de données.
#  - En local (sans Docker) : fichier SQLite relatif au dossier prisma/
#  - Dans Docker : surchargé par docker-compose.yml (file:/data/moodly.db)
#  - Supabase/Postgres : postgresql://... (voir README, section migration)
DATABASE_URL="file:./dev.db"

# Secret de signature des JWT. En production : 32 caractères minimum (openssl rand -hex 32),
# l'API refuse de démarrer sinon.
JWT_SECRET="change-me-moodly-dev-secret"

# Seuil d'anonymat : nombre minimal de réponses pour qu'un jour soit visible par le manager
MIN_RESPONSES=3

# Origines autorisées pour CORS, séparées par des virgules. « * » en dev ; vide = CORS désactivé
# (app web servie sur la même origine que l'API, apps mobiles). « * » est refusé en production.
CORS_ORIGIN="*"

# Fuseau horaire utilisé pour déterminer "aujourd'hui" (une saisie par jour)
TIMEZONE="Europe/Paris"

# Nombre de proxys devant l'API (nginx, Caddy…), pour lire la vraie IP du client. 0 en direct.
TRUST_PROXY=0

# Durée de conservation des réponses anonymes et des actions, en jours (13 mois par défaut).
# Les Submission (qui a répondu) ne sont jamais conservées au-delà du jour même.
DATA_RETENTION_DAYS=395

# Durée de conservation d'une demande (et de ses messages) après sa résolution, en jours.
CASE_RETENTION_DAYS=365

# Niveau de journalisation : fatal, error, warn, info (défaut), debug, trace, silent
# LOG_LEVEL=info

# Tentatives de connexion par quart d'heure et par IP (anti force brute)
# LOGIN_RATE_LIMIT=20
