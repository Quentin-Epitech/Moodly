# Configuration de production — copier en `backend/.env.production` sur le serveur (jamais versionné).
# Utilisé par docker-compose.prod.yml. Voir PRODUCTION.md.

NODE_ENV=production
PORT=4000

# Dans docker-compose.prod.yml, la base SQLite vit sur le volume /data.
# Pour Postgres / Supabase : postgresql://… (et provider "postgresql" dans prisma/schema.prisma)
DATABASE_URL="file:/data/moodly.db"

# OBLIGATOIRE : générer avec `openssl rand -hex 32`. L'API refuse de démarrer avec un secret faible.
JWT_SECRET=

MIN_RESPONSES=3

# L'app web est servie sur la même origine que l'API (/api) et les apps mobiles n'envoient pas
# d'en-tête Origin : CORS désactivé. Ne jamais mettre « * ».
CORS_ORIGIN=

TIMEZONE="Europe/Paris"

# Caddy (HTTPS) → nginx (app web) → API : deux proxys
TRUST_PROXY=2

DATA_RETENTION_DAYS=395
CASE_RETENTION_DAYS=365
LOG_LEVEL=info
